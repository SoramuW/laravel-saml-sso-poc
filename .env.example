APP_NAME="Laravel SAML SSO PoC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel_saml
DB_USERNAME=laravel
DB_PASSWORD=laravel
DB_ROOT_PASSWORD=local-root-only
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync

KEYCLOAK_PORT=8081
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=local-admin-only

SAML_PROVIDER=keycloak
SAML_SP_ENTITY_ID=laravel-saml
SAML_SP_ACS_URL=http://localhost:8000/saml/acs
SAML_SP_SLS_URL=http://localhost:8000/saml/sls
SAML_SP_CERT_PATH=storage/saml/sp.pem
SAML_SP_KEY_PATH=storage/saml/sp.key
SAML_NAME_ID_FORMAT=urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified
SAML_IDP_ENTITY_ID=http://localhost:8081/realms/saml-demo
SAML_IDP_SSO_URL=http://localhost:8081/realms/saml-demo/protocol/saml
SAML_IDP_SLO_URL=http://localhost:8081/realms/saml-demo/protocol/saml
SAML_IDP_CERT_PATH=storage/saml/keycloak-idp.pem
SAML_LOCAL_METADATA_URL=http://keycloak:8080/realms/saml-demo/protocol/saml/descriptor
SAML_AUTO_CREATE_USER=true
SAML_ALLOW_EMAIL_LINKING=false
SAML_ATTRIBUTE_USERNAME=username
SAML_ATTRIBUTE_EMAIL=email
SAML_ATTRIBUTE_FIRST_NAME=firstName
SAML_ATTRIBUTE_LAST_NAME=lastName
SAML_AUTHN_REQUESTS_SIGNED=true
SAML_LOGOUT_REQUESTS_SIGNED=true
SAML_LOGOUT_RESPONSES_SIGNED=true
SAML_WANT_ASSERTIONS_SIGNED=true
